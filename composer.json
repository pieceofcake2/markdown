{
    "name": "pieceofcake2/markdown",
    "type": "cakephp-plugin",
    "description": "A CakePHP 2.x Markdown helper packaged as a plugin.",
    "keywords": ["cakephp", "cakephp2", "helper", "markdown"],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "composer/installers": "*",
        "michelf/php-markdown": "^2.0",
        "pieceofcake2/cakephp": "^2.10"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.1",
        "pieceofcake2/phpstan-cakephp2": "^0.2.1"
    },
    "replace": {
        "chronon/markdown": "^2.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "Markdown"
    }
}
