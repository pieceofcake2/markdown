{
    "name": "pieceofcake2/markdown",
    "type": "cakephp-plugin",
    "description": "CakePHP 2 helper that converts Markdown to HTML with PHP Markdown Extra",
    "keywords": ["cakephp", "cakephp2", "helper", "markdown"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "composer/installers": "^1.0 || ^2.0",
        "michelf/php-markdown": "^2.0",
        "pieceofcake2/cakephp": "^2.12"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpcs-cakephp2": "^1.0",
        "pieceofcake2/phpstan-cakephp2": "^0.2.3"
    },
    "replace": {
        "chronon/markdown": "^2.0"
    },
    "autoload-dev": {
        "exclude-from-classmap": [
            "vendor/pieceofcake2/app/src/Console/Command/AppShell.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "Markdown"
    }
}
